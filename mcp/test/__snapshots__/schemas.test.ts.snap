  "market_recent_trades": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "after": {
        "description": "Unix ms lower bound, exclusive.",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
