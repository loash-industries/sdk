        "pattern": "^\\d+$",
        "type": "string",
      },
      "orderId": {
        "description": "Order id (Move u128) as a decimal string, from open orders or discovery.",
        "pattern": "^\\d+$",
        "type": "string",
      },
      "sender": {
        "description": "Sui address the transaction is built for; only this address can sign the result.",
