  "market_recent_trades": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "after": {
        "description": "Unix ms lower bound, exclusive.",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer",
      },
      "assetId": {
        "description": "Only trades of this item type, e.g. "77800".",
        "type": "string",
      },
      "before": {
        "description": "Unix ms upper bound, exclusive.",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer",
      },
      "limit": {
        "description": "Trades per page (max 50 — the gateway caps it there).",
        "exclusiveMinimum": 0,
        "maximum": 50,
        "type": "integer",
      },
      "publicOnly": {
        "description": "Only trades at hubs that publish their location.",
        "type": "boolean",
      },
    },
    "type": "object",
  },
