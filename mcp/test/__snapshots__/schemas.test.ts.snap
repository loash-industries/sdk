        "description": "Base coin type, e.g. "0x…::wbtc::WBTC". Give this or poolId; resolved via the on-chain pool registry.",
        "pattern": "^0x[0-9a-fA-F]{1,64}::[A-Za-z_][A-Za-z0-9_]*::[A-Za-z_][A-Za-z0-9_]*(<.+>)?$",
        "type": "string",
      },
      "poolId": {
        "description": "Coin pool object id. Give this or baseCoinType.",
