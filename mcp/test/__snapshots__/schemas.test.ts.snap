  "prepare_org_create": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "board": {
        "description": "Root board; defaults to [sender].",
        "items": {
          "pattern": "^0x[0-9a-fA-F]{1,64}$",
          "type": "string",
        },
        "type": "array",
      },
      "enableTrading": {
        "description": "Default true.",
        "type": "boolean",
      },
      "freezeAdmin": {
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
      "memberMetadataUri": {
        "type": "string",
      },
      "memberName": {
        "type": "string",
      },
      "members": {
        "description": "Line members (the sender is always added).",
        "items": {
          "pattern": "^0x[0-9a-fA-F]{1,64}$",
          "type": "string",
        },
        "type": "array",
      },
      "metadataUri": {
        "minLength": 1,
        "type": "string",
      },
      "name": {
        "minLength": 1,
        "type": "string",
      },
      "officerMetadataUri": {
        "type": "string",
      },
      "officerName": {
        "type": "string",
      },
      "officers": {
        "description": "Officers (the sender is always added).",
        "items": {
          "pattern": "^0x[0-9a-fA-F]{1,64}$",
          "type": "string",
        },
        "type": "array",
      },
      "overrides": {
        "additionalProperties": false,
        "description": "Extra ou::ProposalTypeInit entries per tier.",
        "properties": {
          "members": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "config": {
                  "additionalProperties": false,
                  "properties": {
                    "approvalThreshold": {
                      "description": "Share of CAST votes that must approve.",
                      "maximum": 10000,
                      "minimum": 0,
                      "type": "integer",
                    },
                    "borrowScope": {
                      "description": "Capability Move types a VAULT_BORROW type may borrow.",
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                    "composableAllowed": {
                      "type": "boolean",
                    },
                    "cooldownMs": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer",
                    },
                    "executionDelayMs": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer",
                    },
                    "expiryMs": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer",
                    },
                    "permissions": {
                      "description": "armature::permissions bits the type’s requests carry. Any high-impact bit needs approvalThreshold ≥ 8000.",
                      "maximum": 9007199254740991,
                      "minimum": 0,
