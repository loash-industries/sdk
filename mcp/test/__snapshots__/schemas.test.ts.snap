  "prepare_coin_limit_order": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "baseCoinType": {
        "description": "Base coin type, e.g. "0x…::wbtc::WBTC". Give this or poolId; resolved via the on-chain pool registry.",
        "pattern": "^0x[0-9a-fA-F]{1,64}::[A-Za-z_][A-Za-z0-9_]*::[A-Za-z_][A-Za-z0-9_]*(<.+>)?$",
        "type": "string",
      },
      "expireAt": {
        "description": "Unix ms; omit for good-til-cancelled.",
        "pattern": "^\\d+$",
        "type": "string",
      },
      "orderType": {
        "description": "0=LIMIT (default), 1=IOC, 2=FOK, 3=POST_ONLY.",
        "maximum": 3,
        "minimum": 0,
        "type": "integer",
      },
      "poolId": {
        "description": "Coin pool object id. Give this or baseCoinType.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
      "price": {
        "description": "Raw 1e9-scaled price, in [1, 2^63−1].",
        "pattern": "^\\d+$",
        "type": "string",
      },
      "quantity": {
        "description": "Base quantity, raw units.",
        "pattern": "^\\d+$",
        "type": "string",
      },
      "quoteCoinType": {
        "description": "Quote coin type; defaults to CRED, the permissionless quote.",
        "pattern": "^0x[0-9a-fA-F]{1,64}::[A-Za-z_][A-Za-z0-9_]*::[A-Za-z_][A-Za-z0-9_]*(<.+>)?$",
        "type": "string",
      },
      "quoteDeposit": {
        "description": "Override the quote held for a buy. Defaults to the never-under-funded deposit.",
        "pattern": "^\\d+$",
        "type": "string",
      },
      "selfMatchingOption": {
        "description": "0=allowed (default), 1=cancel taker, 2=cancel maker.",
        "maximum": 2,
        "minimum": 0,
        "type": "integer",
      },
      "sender": {
        "description": "Sui address the transaction is built for; only this address can sign the result.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
      "side": {
        "enum": [
          "buy",
          "sell",
        ],
        "type": "string",
      },
    },
    "required": [
      "sender",
      "side",
      "price",
      "quantity",
    ],
    "type": "object",
  },
