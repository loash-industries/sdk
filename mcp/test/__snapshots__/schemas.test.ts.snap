  "prepare_org_add_members": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "addresses": {
        "items": {
          "pattern": "^0x[0-9a-fA-F]{1,64}$",
          "type": "string",
        },
        "minItems": 1,
        "type": "array",
      },
      "metadataIpfs": {
        "description": "IPFS reference recorded on the proposal (ProposalCreated.metadata_ipfs). Upload it first — this server hosts nothing.",
        "minLength": 1,
        "type": "string",
      },
      "orgId": {
        "description": "Organization object id — the root or any unit in its tree.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
      "seat": {
        "description": "Unit id to act THROUGH (whose board votes). Defaults to the caller’s highest-authority seat.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
      "sender": {
        "description": "Sui address the transaction is built for; only this address can sign it. Also the address whose board seat is resolved.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
      "unitId": {
        "description": "The unit to act ON (default: the acting seat). A parent’s board can target a child it does not sit on — the action then routes through the parent’s SubOUControl.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
    },
    "required": [
      "orgId",
      "sender",
      "addresses",
    ],
    "type": "object",
  },
