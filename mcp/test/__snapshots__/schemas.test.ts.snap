        "maximum": 9007199254740991,
        "type": "integer",
      },
      "limit": {
        "exclusiveMinimum": 0,
        "maximum": 200,
        "type": "integer",
      },
      "tradingAccountId": {
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
    },
    "required": [
      "tradingAccountId",
    ],
    "type": "object",
  },
  "orders_get": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
