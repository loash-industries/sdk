  "prepare_deposit_currency": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "amount": {
        "description": "CRED in base units (6 decimals).",
        "pattern": "^\\d+$",
