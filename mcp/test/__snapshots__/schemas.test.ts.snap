  "prepare_coin_swap": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "amountIn": {
        "description": "Raw amount of the coin being spent, taken from the wallet.",
        "pattern": "^\\d+$",
        "type": "string",
      },
      "baseCoinType": {
        "description": "Base coin type, e.g. "0x…::wbtc::WBTC". Give this or poolId; resolved via the on-chain pool registry.",
        "pattern": "^0x[0-9a-fA-F]{1,64}::[A-Za-z_][A-Za-z0-9_]*::[A-Za-z_][A-Za-z0-9_]*(<.+>)?$",
        "type": "string",
      },
      "minOut": {
        "description": "Minimum output or the swap aborts. Defaults from a dry-run.",
        "pattern": "^\\d+$",
        "type": "string",
      },
      "poolId": {
        "description": "Coin pool object id. Give this or baseCoinType.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
      "quoteCoinType": {
        "description": "Quote coin type; defaults to CRED, the permissionless quote.",
        "pattern": "^0x[0-9a-fA-F]{1,64}::[A-Za-z_][A-Za-z0-9_]*::[A-Za-z_][A-Za-z0-9_]*(<.+>)?$",
        "type": "string",
      },
      "sender": {
        "description": "Sui address the transaction is built for; only this address can sign the result.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
      "side": {
        "description": ""buy" spends quote for base; "sell" the reverse.",
        "enum": [
          "buy",
          "sell",
        ],
        "type": "string",
      },
      "slippageBps": {
        "description": "Tolerance off the dry-run when minOut is omitted (default 50 = 0.5%).",
        "maximum": 10000,
        "minimum": 0,
        "type": "integer",
      },
    },
    "required": [
      "sender",
      "side",
      "amountIn",
    ],
    "type": "object",
  },
