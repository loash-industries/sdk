  "prepare_org_upgrade_propose": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "build": {
        "additionalProperties": false,
        "properties": {
          "dependencies": {
            "items": {
              "pattern": "^0x[0-9a-fA-F]{1,64}$",
              "type": "string",
            },
            "type": "array",
          },
          "modules": {
            "description": "Base64 module bytecode.",
            "items": {
              "type": "string",
            },
            "minItems": 1,
            "type": "array",
          },
        },
        "required": [
          "modules",
          "dependencies",
        ],
        "type": "object",
      },
      "capId": {
        "description": "The UpgradeCap id in the unit’s vault.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
      "digest": {
        "description": "The new package digest, 32 bytes.",
        "items": {
          "maximum": 255,
          "minimum": 0,
          "type": "integer",
        },
        "maxItems": 32,
        "minItems": 32,
        "type": "array",
      },
      "metadataIpfs": {
        "description": "IPFS reference recorded on the proposal (ProposalCreated.metadata_ipfs). Upload it first — this server hosts nothing.",
        "minLength": 1,
        "type": "string",
      },
      "orgId": {
        "description": "Organization object id — the root or any unit in its tree.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
      "packageId": {
        "description": "The package being upgraded.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
      "policy": {
        "anyOf": [
          {
            "const": 0,
            "type": "number",
          },
          {
            "const": 128,
            "type": "number",
          },
          {
            "const": 192,
            "type": "number",
          },
        ],
        "description": "0 compatible (default), 128 additive, 192 dep-only.",
      },
      "seat": {
        "description": "Unit id to act THROUGH (whose board votes). Defaults to the caller’s highest-authority seat.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
      "sender": {
        "description": "Sui address the transaction is built for; only this address can sign it. Also the address whose board seat is resolved.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
      "unitId": {
        "description": "The unit to act ON (default: the acting seat). A parent’s board can target a child it does not sit on — the action then routes through the parent’s SubOUControl.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
    },
    "required": [
      "orgId",
      "sender",
      "capId",
      "packageId",
      "digest",
    ],
    "type": "object",
  },
