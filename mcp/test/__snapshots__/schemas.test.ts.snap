    "properties": {
      "productAssetId": {
        "description": "Asset id of the item to craft, e.g. "77753".",
        "minLength": 1,
        "type": "string",
      },
    },
    "required": [
      "productAssetId",
    ],
    "type": "object",
  },
}
`;
