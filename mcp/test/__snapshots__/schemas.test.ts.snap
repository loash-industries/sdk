  "prepare_limit_order": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "assetId": {
        "description": "EVE Frontier item asset id, e.g. "70810".",
        "type": "string",
      },
      "expireAt": {
        "description": "Unix ms; omit for good-til-cancelled.",
        "pattern": "^\\d+$",
        "type": "string",
      },
      "orderType": {
        "description": "0=LIMIT, 1=IOC, 2=FOK, 3=POST_ONLY.",
        "maximum": 3,
        "minimum": 0,
        "type": "integer",
      },
      "price": {
        "description": "CRED base units per item.",
        "pattern": "^\\d+$",
        "type": "string",
      },
      "quantity": {
        "description": "Whole item units; must be a multiple of lot size.",
        "pattern": "^\\d+$",
        "type": "string",
      },
      "quoteDeposit": {
        "description": "Override the computed CRED deposit for a bid.",
        "pattern": "^\\d+$",
        "type": "string",
      },
      "selfMatchingOption": {
        "maximum": 2,
        "minimum": 0,
        "type": "integer",
      },
      "sender": {
        "description": "Sui address the transaction is built for; only this address can sign the result.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
      "side": {
        "enum": [
          "buy",
          "sell",
        ],
        "type": "string",
      },
      "storageUnitId": {
        "description": "Trade hub / storage unit object id.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
    },
    "required": [
      "sender",
      "storageUnitId",
      "assetId",
      "side",
      "price",
      "quantity",
    ],
    "type": "object",
  },
