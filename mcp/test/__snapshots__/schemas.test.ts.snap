      },
      "seat": {
        "description": "Unit id to act through. Defaults to the caller’s highest-authority seat.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
      "sender": {
        "description": "Sui address the transaction is built for; only this address can sign it. Also the address whose board seat is resolved.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
    },
    "required": [
      "orgId",
      "sender",
      "proposalId",
      "approve",
    ],
    "type": "object",
  },
  "prepare_register_account": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "sender": {
        "description": "Sui address the transaction is built for; only this address can sign the result.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
    },
    "required": [
      "sender",
    ],
    "type": "object",
  },
  "prepare_revoke_account_cap": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "capId": {
        "description": "Cap object id on the account’s allow-list.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
      "sender": {
        "description": "Sui address the transaction is built for; only this address can sign the result.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
    },
    "required": [
      "sender",
      "capId",
    ],
    "type": "object",
  },
  "prepare_withdraw_currency": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "amount": {
        "pattern": "^\\d+$",
        "type": "string",
      },
      "sender": {
        "description": "Sui address the transaction is built for; only this address can sign the result.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
    },
    "required": [
      "sender",
    ],
    "type": "object",
  },
  "prepare_withdraw_items": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "characterId": {
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
      "items": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "assetId": {
              "type": "string",
            },
          },
          "required": [
            "assetId",
          ],
          "type": "object",
        },
        "minItems": 1,
        "type": "array",
      },
      "sender": {
        "description": "Sui address the transaction is built for; only this address can sign the result.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
      "storageUnitId": {
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
    },
    "required": [
      "sender",
      "storageUnitId",
      "items",
    ],
    "type": "object",
  },
  "routing_compare": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "destination": {
        "description": "Arrival solar system NAME, case-insensitive. Not an id.",
        "minLength": 1,
        "pattern": "\\D",
        "type": "string",
      },
      "gateWeight": {
        "description": "Preference for stargates over jump drives, 0–1 (default 0.5). Used by the balanced mode only.",
        "maximum": 1,
        "minimum": 0,
        "type": "number",
      },
      "mass": {
        "description": "Ship mass in game units (default 1.0); heavier pushes fuel-optimal routes onto stargates.",
        "exclusiveMinimum": 0,
        "type": "number",
      },
      "maxJumpRangeLy": {
        "description": "The ship’s jump-drive range in light years (default 50). A larger range can connect a pair that otherwise fails.",
        "exclusiveMinimum": 0,
        "type": "number",
      },
      "origin": {
        "description": "Departure solar system NAME, case-insensitive, e.g. "U4T-SL7". Not an id.",
        "minLength": 1,
        "pattern": "\\D",
        "type": "string",
      },
    },
    "required": [
      "origin",
      "destination",
    ],
    "type": "object",
  },
  "routing_route": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "destination": {
        "description": "Arrival solar system NAME, case-insensitive. Not an id.",
        "minLength": 1,
        "pattern": "\\D",
        "type": "string",
      },
      "gateWeight": {
        "description": "Preference for stargates over jump drives, 0–1 (default 0.5). Used by the balanced mode only.",
        "maximum": 1,
        "minimum": 0,
        "type": "number",
      },
      "mass": {
        "description": "Ship mass in game units (default 1.0); heavier pushes fuel-optimal routes onto stargates.",
        "exclusiveMinimum": 0,
        "type": "number",
      },
      "maxJumpRangeLy": {
        "description": "The ship’s jump-drive range in light years (default 50). A larger range can connect a pair that otherwise fails.",
        "exclusiveMinimum": 0,
        "type": "number",
      },
      "optimization": {
        "description": "time (default), fuel, or balanced. The answer names the mode differently (fastest, fuel_efficient, balanced).",
        "enum": [
          "time",
          "fuel",
          "balanced",
        ],
        "type": "string",
      },
      "origin": {
        "description": "Departure solar system NAME, case-insensitive, e.g. "U4T-SL7". Not an id.",
        "minLength": 1,
        "pattern": "\\D",
        "type": "string",
      },
    },
    "required": [
      "origin",
      "destination",
    ],
    "type": "object",
  },
  "routing_stats": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {},
    "type": "object",
  },
  "spatial_autocomplete_systems": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "limit": {
        "description": "Suggestions to return (default 10, max 50).",
        "exclusiveMinimum": 0,
        "maximum": 50,
        "type": "integer",
      },
      "query": {
        "description": "Name prefix, case-insensitive.",
        "minLength": 1,
        "type": "string",
      },
    },
    "required": [
      "query",
    ],
    "type": "object",
  },
  "spatial_nearby_systems": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "limit": {
        "description": "Systems to return, nearest first (default 100, max 1000).",
        "exclusiveMinimum": 0,
        "maximum": 1000,
        "type": "integer",
      },
      "radiusLy": {
        "description": "Search radius in light years (max 10,000).",
        "exclusiveMinimum": 0,
        "maximum": 10000,
        "type": "number",
      },
      "solarSystem": {
        "description": "Origin system name or numeric id.",
        "minLength": 1,
        "type": "string",
      },
    },
    "required": [
      "solarSystem",
      "radiusLy",
    ],
    "type": "object",
  },
  "spatial_stats": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {},
    "type": "object",
  },
  "spatial_system": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "solarSystem": {
        "description": "Solar system name (case-insensitive) or numeric id.",
        "minLength": 1,
        "type": "string",
      },
    },
    "required": [
      "solarSystem",
    ],
    "type": "object",
  },
  "spatial_systems": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "solarSystemIds": {
        "description": "Numeric solar system ids (max 100). Omit if using names.",
        "items": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "maxItems": 100,
        "minItems": 1,
        "type": "array",
      },
      "solarSystemNames": {
        "description": "Solar system names (max 100). Omit if using ids.",
        "items": {
          "minLength": 1,
          "type": "string",
        },
        "maxItems": 100,
        "minItems": 1,
        "type": "array",
      },
    },
    "type": "object",
  },
  "spatial_systems_near_coordinates": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "limit": {
        "description": "Systems to return, nearest first (default 100, max 1000).",
        "exclusiveMinimum": 0,
        "maximum": 1000,
        "type": "integer",
      },
      "radiusLy": {
        "description": "Search radius in light years (max 10,000).",
        "exclusiveMinimum": 0,
        "maximum": 10000,
        "type": "number",
      },
      "x": {
        "description": "X coordinate of the origin, in metres.",
        "pattern": "^-?\\d+$",
        "type": "string",
      },
      "y": {
        "description": "Y coordinate of the origin, in metres.",
        "pattern": "^-?\\d+$",
        "type": "string",
      },
      "z": {
        "description": "Z coordinate of the origin, in metres.",
        "pattern": "^-?\\d+$",
        "type": "string",
      },
    },
    "required": [
      "x",
      "y",
      "z",
      "radiusLy",
    ],
    "type": "object",
  },
  "world_item": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "assetId": {
        "description": "Item asset id, e.g. "77800".",
