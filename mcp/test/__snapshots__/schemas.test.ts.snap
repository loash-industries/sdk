      },
    },
    "required": [
      "coinType",
      "address",
    ],
    "type": "object",
  },
  "coins_estimate_market": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "baseCoinType": {
        "description": "Base coin type, e.g. "0x…::wbtc::WBTC". Give this or poolId; resolved via the on-chain pool registry.",
        "pattern": "^0x[0-9a-fA-F]{1,64}::[A-Za-z_][A-Za-z0-9_]*::[A-Za-z_][A-Za-z0-9_]*(<.+>)?$",
        "type": "string",
      },
      "depth": {
        "description": "Book depth to walk (default 100, the matching limit).",
        "exclusiveMinimum": 0,
        "maximum": 1000,
        "type": "integer",
      },
      "poolId": {
        "description": "Coin pool object id. Give this or baseCoinType.",
        "pattern": "^0x[0-9a-fA-F]{1,64}$",
        "type": "string",
      },
      "quantity": {
        "description": "Base quantity of the market order, raw units.",
        "pattern": "^\\d+$",
        "type": "string",
      },
      "quoteCoinType": {
        "description": "Quote coin type; defaults to CRED, the permissionless quote.",
        "pattern": "^0x[0-9a-fA-F]{1,64}::[A-Za-z_][A-Za-z0-9_]*::[A-Za-z_][A-Za-z0-9_]*(<.+>)?$",
        "type": "string",
      },
      "side": {
        "enum": [
          "buy",
          "sell",
        ],
        "type": "string",
      },
      "takerFeeRateScaled": {
        "description": "Taker rate to price at, 1e9-scaled. Defaults to the conservative entry-rung rate.",
        "pattern": "^\\d+$",
        "type": "string",
      },
    },
    "required": [
      "side",
      "quantity",
    ],
    "type": "object",
  },
  "coins_list": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
