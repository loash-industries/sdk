{
  "name": "@trinaryex/mcp",
  "version": "3.2.1",
  "description": "Keyless, multi-tenant MCP server for Trinary Exchange \u2014 market reads and unsigned transaction preparation for EVE Frontier trading agents.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "triex-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:parity": "npm run build && node scripts/check-parity.mjs",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:cov": "node --experimental-vm-modules node_modules/.bin/jest --ci --coverage --reporters=default --reporters=jest-junit",
    "prettier": "prettier --write '{src,test}/**/*.ts'",
    "prettier:check": "prettier --check '{src,test}/**/*.ts'",
    "lint": "eslint --cache '{src,test}/**/*.ts'",
    "lint:check": "eslint --cache '{src,test}/**/*.ts'",
    "lint:fix": "eslint --cache --fix '{src,test}/**/*.ts'",
    "tscheck": "tsc --noEmit"
  },
  "author": "@blurpesec",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mysten/sui": "^2.16.0",
    "@trinaryex/sdk": "^3.2.1",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.3.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.2"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "moduleFileExtensions": [
      "js",
      "mjs",
      "json",
      "ts"
    ],
    "testRegex": ".test.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true,
          "diagnostics": false
        }
      ]
    },
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,js}"
    ],
    "testEnvironment": "node",
    "coverageDirectory": "./coverage"
  },
  "jest-junit": {
    "outputDirectory": ".",
    "outputName": "junit.xml"
  }
}
