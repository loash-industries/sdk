# Trinary Exchange API key (reads via api.trinary.exchange).
# Create one at https://trinary.exchange/settings — see
# https://docs.trinary.exchange/docs/api-keys
TRIEX_API_KEY=

# Bot signer (server/keypair use). NEVER commit a real key.
# Sui private key (suiprivkey1... bech32) for the trading account.
SUI_PRIVATE_KEY=
